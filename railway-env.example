# Paste these keys into Railway > Variables.
# Replace placeholder values in Railway only.
# Do not commit a real .env file with secrets.

STRUCTUREBASE_ENV=production
STRUCTUREBASE_SECRET=replace-with-a-new-long-random-secret
STRUCTUREBASE_STRICT_STARTUP_CHECKS=1
STRUCTUREBASE_TRUST_PROXY_COUNT=1
STRUCTUREBASE_LOG_LEVEL=INFO

STRUCTUREBASE_DATABASE_BACKEND=mongodb
STRUCTUREBASE_MONGODB_URI=replace-with-your-rotated-mongodb-uri
STRUCTUREBASE_MONGODB_DB_NAME=structurebase
STRUCTUREBASE_MONGODB_COLLECTION=listings
STRUCTUREBASE_MONGODB_ENQUIRIES_COLLECTION=enquiries
STRUCTUREBASE_MONGODB_ACTIVITY_COLLECTION=activity_log

STRUCTUREBASE_STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=replace-with-your-rotated-cloudinary-url
STRUCTUREBASE_CLOUDINARY_FOLDER=STRUCTUREBASE

STRUCTUREBASE_ADMIN_USERNAME=admin
STRUCTUREBASE_ADMIN_PASSWORD=replace-with-your-railway-admin-password
# Leave STRUCTUREBASE_ADMIN_PASSWORD_HASH unset unless you intentionally use a generated password hash.

STRUCTUREBASE_SESSION_COOKIE_SECURE=1
STRUCTUREBASE_SESSION_HOURS=12
STRUCTUREBASE_LOGIN_MAX_ATTEMPTS=5
STRUCTUREBASE_LOGIN_WINDOW_MINUTES=15

STRUCTUREBASE_CONTACT_EMAIL=replace-with-your-real-contact-email
STRUCTUREBASE_CONTACT_PHONE=+234 800 123 4567
STRUCTUREBASE_CONTACT_PHONE_RAW=+2348001234567
STRUCTUREBASE_WHATSAPP_PHONE=2348001234567
STRUCTUREBASE_SITE_NAME=Structurebase

# Optional email setup. Add all five, or leave all five unset.
# STRUCTUREBASE_SMTP_HOST=smtp.gmail.com
# STRUCTUREBASE_SMTP_PORT=587
# STRUCTUREBASE_SMTP_USERNAME=replace-with-sender-email
# STRUCTUREBASE_SMTP_PASSWORD=replace-with-email-app-password
# STRUCTUREBASE_SMTP_FROM_EMAIL=replace-with-sender-email
