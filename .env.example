# Core app settings
STRUCTUREBASE_SECRET=replace-with-a-long-random-secret
STRUCTUREBASE_ENV=development
STRUCTUREBASE_STRICT_STARTUP_CHECKS=0
STRUCTUREBASE_TRUST_PROXY_COUNT=0
STRUCTUREBASE_LOG_LEVEL=INFO

# Database
# Use `sqlite` while Atlas is still being configured.
# Switch to `mongodb` after the Atlas URI and network access are confirmed working.
STRUCTUREBASE_DATABASE_BACKEND=auto
# Full MongoDB Atlas SRV connection string
STRUCTUREBASE_MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority&appName=structurebase
# Logical database name inside Atlas
STRUCTUREBASE_MONGODB_DB_NAME=structurebase
# Collection used for property listings
STRUCTUREBASE_MONGODB_COLLECTION=listings
# Collection used for direct enquiries
STRUCTUREBASE_MONGODB_ENQUIRIES_COLLECTION=enquiries
STRUCTUREBASE_MONGODB_CONTACTS_COLLECTION=contacts
STRUCTUREBASE_MONGODB_LEAD_NOTES_COLLECTION=lead_notes
STRUCTUREBASE_MONGODB_INSPECTIONS_COLLECTION=inspections
STRUCTUREBASE_MONGODB_PARTNERS_COLLECTION=partners
STRUCTUREBASE_MONGODB_REFERRALS_COLLECTION=referrals
STRUCTUREBASE_MONGODB_REFERRAL_EVENTS_COLLECTION=referral_events
STRUCTUREBASE_REFERRAL_ATTRIBUTION_DAYS=30
STRUCTUREBASE_MONGODB_COMMISSION_RULES_COLLECTION=commission_rules
STRUCTUREBASE_MONGODB_COMMISSIONS_COLLECTION=commissions
STRUCTUREBASE_MONGODB_MARKETING_ASSETS_COLLECTION=marketing_assets
STRUCTUREBASE_MONGODB_PARTNER_MARKETING_EVENTS_COLLECTION=partner_marketing_events
# Collection used for admin activity history
STRUCTUREBASE_MONGODB_ACTIVITY_COLLECTION=activity_log
STRUCTUREBASE_MONGODB_STAFF_COLLECTION=staff_users
STRUCTUREBASE_MONGODB_STAFF_INVITATIONS_COLLECTION=staff_invitations
STRUCTUREBASE_MONGODB_LOGIN_ATTEMPTS_COLLECTION=staff_login_attempts

# File storage
# Leave this as `auto`; the app will use Cloudinary when the credentials below are present.
STRUCTUREBASE_STORAGE_BACKEND=auto
# Preferred Cloudinary setup: full environment URL
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional explicit Cloudinary credentials if you do not want to use CLOUDINARY_URL
STRUCTUREBASE_CLOUDINARY_CLOUD_NAME=your-cloud-name
STRUCTUREBASE_CLOUDINARY_API_KEY=your-cloudinary-api-key
STRUCTUREBASE_CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional Cloudinary folder for uploaded listing images
STRUCTUREBASE_CLOUDINARY_FOLDER=structurebase/listings

# Admin login
STRUCTUREBASE_ADMIN_USERNAME=admin
STRUCTUREBASE_ADMIN_PASSWORD=change-me-before-production
# Used only when the first SUPER_ADMIN account is bootstrapped into an empty database.
STRUCTUREBASE_INITIAL_ADMIN_NAME=Structurebase Owner
STRUCTUREBASE_INITIAL_ADMIN_EMAIL=owner@example.com
STRUCTUREBASE_STAFF_INVITATION_HOURS=48
# Mark cookies secure in HTTPS production environments
STRUCTUREBASE_SESSION_COOKIE_SECURE=0
# Shared admin session lifetime in hours
STRUCTUREBASE_SESSION_HOURS=12
# Rate limit failed login attempts
STRUCTUREBASE_LOGIN_MAX_ATTEMPTS=5
STRUCTUREBASE_LOGIN_WINDOW_MINUTES=15

# Public contact details
STRUCTUREBASE_CONTACT_EMAIL=info@example.com
STRUCTUREBASE_CONTACT_PHONE=+234 800 123 4567
STRUCTUREBASE_CONTACT_PHONE_RAW=+2348001234567
STRUCTUREBASE_WHATSAPP_PHONE=2348001234567
STRUCTUREBASE_SITE_NAME=Structurebase
STRUCTUREBASE_PUBLIC_BASE_URL=http://127.0.0.1:5000
# Keep disabled for local/client-acceptance environments. Enable only on the final public domain.
STRUCTUREBASE_SEARCH_INDEXING_ENABLED=0
STRUCTUREBASE_OFFICE_ADDRESS=Lagos, Nigeria
STRUCTUREBASE_COVERAGE_AREA=Lagos, Abuja, Port Harcourt, and selected markets across Nigeria
STRUCTUREBASE_FOOTER_SUMMARY=Property listings, enquiries, and operations support from a team based in Lagos and active across Nigeria.
STRUCTUREBASE_EMAIL_SENDER_NAME=Structurebase
STRUCTUREBASE_EMAIL_BRAND_TAGLINE=Property sales, rentals, and operations support
STRUCTUREBASE_EMAIL_BRAND_MARKET_LINE=Based in Lagos, active across Nigeria
STRUCTUREBASE_EMAIL_FOOTER_NOTE=Client communications from a Lagos-based team active across Nigeria.
STRUCTUREBASE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# Gmail / Google Workspace SMTP
STRUCTUREBASE_SMTP_HOST=smtp.gmail.com
STRUCTUREBASE_SMTP_PORT=587
# Gmail address or Google Workspace mailbox used to send mail
STRUCTUREBASE_SMTP_USERNAME=you@gmail.com
# Gmail App Password or approved SMTP password
STRUCTUREBASE_SMTP_PASSWORD=your-gmail-app-password
# Visible From address
STRUCTUREBASE_SMTP_FROM_EMAIL=you@gmail.com
